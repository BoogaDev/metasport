# OpenAI
OPENAI_API_KEY=
# If using project-scoped key, also set:
# OPENAI_ORG_ID=
# OPENAI_PROJECT=

# Database: choose ONE path
# 1) Direct Postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# 2) Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE=your_service_role_key

# Timezone used for slugs if model omits start_time_local (defaults to ET)
TZ=America/New_York

